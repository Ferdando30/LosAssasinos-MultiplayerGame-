<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Holder" style="flex-grow: 1; justify-content: flex-end; background-color: rgb(113, 27, 0); flex-shrink: 0; flex-direction: column; flex-wrap: nowrap;">
        <ui:Label text="Los Assassinos" style="align-self: center; justify-content: flex-start; align-items: flex-start; align-content: center; font-size: 57px; -unity-text-align: middle-center; -unity-font-style: normal; top: -15px; flex-grow: 1; flex-direction: row;"/>
        <ui:VisualElement name="TelaInicial" style="flex-grow: 1; top: 42px;">
            <ui:Button text="Criar Sala" name="CriarBtn" style="align-content: center; align-self: center; justify-content: center; height: 51px; width: 229px; top: 50px; flex-grow: 0; flex-direction: row;"/>
