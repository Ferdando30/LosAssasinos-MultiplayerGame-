            <ui:Button text="Options" name="OptionsBtn" style="align-content: center; align-self: center; justify-content: center; height: 51px; width: 229px; top: 216px; flex-grow: 0; flex-direction: row;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ServerHolder" style="flex-grow: 1; top: -103px; right: 32px;">
            <ui:VisualElement name="TelaEnterServer" style="flex-grow: 1;">
                <ui:Button text="Client" name="ClientBtn" style="align-content: center; align-self: center; justify-content: center; height: 51px; width: 222px; top: 88px; right: 197px; flex-direction: row;"/>
