            <ui:TextField label="Ip Adress&#10;" placeholder-text="filler text" name="IpAdress" style="top: -154px; width: 371px; right: -728px; height: 59px; flex-grow: 0;"/>
            <ui:TextField label="Port&#10;" placeholder-text="filler text" name="PortAdress" style="top: -102px; width: 370px; right: -727px; height: 62px;"/>
